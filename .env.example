# =============================================================================
# SlopShield AI — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://slopshield:slopshield_dev@localhost:5433/slopshield?schema=public"

# -----------------------------------------------------------------------------
# Redis (BullMQ Job Queue)
# -----------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
JWT_SECRET="CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING"
JWT_EXPIRATION="24h"
JWT_REFRESH_EXPIRATION="7d"

# -----------------------------------------------------------------------------
# Google Gemini AI (AI Reviewer)
# -----------------------------------------------------------------------------
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.5-pro"

# -----------------------------------------------------------------------------
# Lark Integration
# -----------------------------------------------------------------------------
LARK_APP_ID="your-lark-app-id"
LARK_APP_SECRET="your-lark-app-secret"
LARK_WEBHOOK_VERIFICATION_TOKEN="your-webhook-verification-token"
LARK_DEFAULT_CHAT_ID="your-default-lark-group-chat-id"

# -----------------------------------------------------------------------------
# Scan Configuration
# -----------------------------------------------------------------------------
SCAN_TIMEOUT_MS=120000
SCAN_TEMP_DIR="./tmp/scans"
SCAN_CLEANUP_TTL_HOURS=24
MAX_UPLOAD_SIZE_MB=50
# Per-analyzer timeout enforced by the scan orchestrator (ms). Default 45000.
ANALYZER_TIMEOUT_MS=45000
# Max number of files sent to heavy analyzers (TypeScript, Semgrep, Gemini). Default 50.
MAX_ANALYZE_FILES=50

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
API_PORT=3001
WEB_PORT=3000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# -----------------------------------------------------------------------------
# Frontend (Web_App) — public, build-time variables
# -----------------------------------------------------------------------------
# "mock" serves seeded demo data; "live" calls the hosted API.
NEXT_PUBLIC_API_MODE=mock
# Base URL of the deployed API including the /api global prefix (live mode only).
NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# -----------------------------------------------------------------------------
# GitHub Repository Ingestion
# -----------------------------------------------------------------------------
# Maximum repository tarball size accepted while streaming (bytes). Default 100 MB.
MAX_REPO_BYTES=104857600
# Maximum number of files extracted into the scan directory. Default 5000.
MAX_FILE_COUNT=5000
# Maximum time allowed for the repository fetch operation (ms). Default 60000.
FETCH_TIMEOUT_MS=60000
# Optional GitHub access token for higher rate limits and private repositories.
# Leave empty for anonymous access to public repositories.
GITHUB_TOKEN=""
