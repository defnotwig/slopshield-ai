# =============================================================================
# SlopShield AI — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://slopshield:slopshield_dev@localhost:5433/slopshield?schema=public"

# -----------------------------------------------------------------------------
# Redis (BullMQ Job Queue)
# -----------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
JWT_SECRET="CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING"
JWT_EXPIRATION="24h"
JWT_REFRESH_EXPIRATION="7d"

# -----------------------------------------------------------------------------
# Google Gemini AI (AI Reviewer)
# -----------------------------------------------------------------------------
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.5-pro"

# -----------------------------------------------------------------------------
# Lark Integration
# -----------------------------------------------------------------------------
LARK_APP_ID="your-lark-app-id"
LARK_APP_SECRET="your-lark-app-secret"
LARK_WEBHOOK_VERIFICATION_TOKEN="your-webhook-verification-token"
LARK_DEFAULT_CHAT_ID="your-default-lark-group-chat-id"

# -----------------------------------------------------------------------------
# Scan Configuration
# -----------------------------------------------------------------------------
SCAN_TIMEOUT_MS=120000
SCAN_TEMP_DIR="./tmp/scans"
SCAN_CLEANUP_TTL_HOURS=24
MAX_UPLOAD_SIZE_MB=50
# Per-analyzer timeout enforced by the scan orchestrator (ms). Default 45000.
ANALYZER_TIMEOUT_MS=45000
# Max number of files sent to heavy analyzers (TypeScript, Semgrep, Gemini). Default 50.
MAX_ANALYZE_FILES=50

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
API_PORT=3001
WEB_PORT=3000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# -----------------------------------------------------------------------------
# Rate Limiting (@nestjs/throttler) — all optional; sensible defaults applied.
# TTL values are in milliseconds; limits are max requests per window.
# -----------------------------------------------------------------------------
# Global default applied to every route. Default: 100 requests / 60000 ms.
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_TTL_MS=60000
# Tighter limit on POST /auth/login. Default: 5 requests / 60000 ms.
RATE_LIMIT_LOGIN=5
RATE_LIMIT_LOGIN_TTL_MS=60000
# Tighter limit on POST /scans. Default: 10 requests / 60000 ms.
RATE_LIMIT_SCAN=10
RATE_LIMIT_SCAN_TTL_MS=60000

# -----------------------------------------------------------------------------
# Frontend (Web_App) — public, build-time variables
# -----------------------------------------------------------------------------
# "mock" serves seeded demo data; "live" calls the hosted API.
NEXT_PUBLIC_API_MODE=mock
# Base URL of the deployed API including the /api global prefix (live mode only).
NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# -----------------------------------------------------------------------------
# GitHub Repository Ingestion
# -----------------------------------------------------------------------------
# Maximum repository tarball size accepted while streaming (bytes). Default 100 MB.
MAX_REPO_BYTES=104857600
# Maximum number of files extracted into the scan directory. Default 5000.
MAX_FILE_COUNT=5000
# Maximum time allowed for the repository fetch operation (ms). Default 60000.
FETCH_TIMEOUT_MS=60000
# Optional GitHub access token for higher rate limits and private repositories.
# Leave empty for anonymous access to public repositories.
GITHUB_TOKEN=""

# -----------------------------------------------------------------------------
# OAuth Integration
# -----------------------------------------------------------------------------
# GitHub OAuth App credentials (register at https://github.com/settings/applications/new)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=https://your-api-domain.com/api/oauth/github/callback

# Lark OAuth App credentials
LARK_OAUTH_APP_ID=
LARK_OAUTH_APP_SECRET=
LARK_OAUTH_CALLBACK_URL=https://your-api-domain.com/api/oauth/lark/callback

# 32-byte hex key for AES-256-GCM encryption of OAuth tokens
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# GitHub App Integration (PR Status Checks)
# -----------------------------------------------------------------------------
# Set to "true" to enable the GitHub App webhook endpoint
GITHUB_APP_ENABLED=false
# GitHub App ID (from the App's settings page)
GITHUB_APP_ID=
# GitHub App private key (PEM format, can be multiline)
GITHUB_APP_PRIVATE_KEY=
# Webhook secret configured in the GitHub App settings
GITHUB_APP_WEBHOOK_SECRET=
# Maximum time in seconds for a PR-triggered scan before timeout (default: 300)
GITHUB_APP_SCAN_TIMEOUT=300
# Maximum webhook-triggered scans per installation per hour (default: 60)
GITHUB_APP_RATE_LIMIT_PER_INSTALLATION=60
# Maximum concurrent PR-triggered scans globally (default: 10)
GITHUB_APP_GLOBAL_CONCURRENT_SCANS=10
