// =============================================================================
// SlopShield AI — Prisma Schema
// =============================================================================
// Defines all database models for the SlopShield scan pipeline, findings,
// scoring, Lark integration, and user/project management.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// User — Authenticated users who trigger scans and receive assignments
// ---------------------------------------------------------------------------
model User {
  id         String   @id @default(uuid())
  name       String
  email      String   @unique
  password   String
  role       String   @default("developer")
  larkUserId String?  @map("lark_user_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  scanJobs            ScanJob[]
  fixTasks            FixTask[]
  memberships         ProjectMember[]
  notificationSetting NotificationSetting?
  refreshTokens       RefreshToken[]
  connectedAccounts   ConnectedAccount[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// RefreshToken — Revocable refresh-token records (Req 1.5, 1.7)
// ---------------------------------------------------------------------------
// Each issued refresh token embeds a unique `jti` claim that maps to a row
// here. Logout sets `revokedAt`; the refresh endpoint rejects any token whose
// `jti` is missing, revoked, or past `expiresAt`.
// ---------------------------------------------------------------------------
model RefreshToken {
  id        String    @id @default(uuid())
  jti       String    @unique
  userId    String    @map("user_id")
  revokedAt DateTime? @map("revoked_at")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Project — Repositories or codebases that are scanned
// ---------------------------------------------------------------------------
model Project {
  id             String   @id @default(uuid())
  name           String
  repositoryUrl  String?  @map("repository_url")
  framework      String?
  minimumScore   Int      @default(80) @map("minimum_score")
  larkChatId     String?  @map("lark_chat_id")
  teamLeadLarkId String?  @map("team_lead_lark_id")
  // Per-project custom scan rules: array of { id, name, pattern, flags?, severity,
  // category, message, recommendation?, blocking?, fileGlobs? }. Applied by the
  // CustomRuleAnalyzer as an extra pass after the built-in analyzers.
  customRules    Json?    @map("custom_rules")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  scanJobs ScanJob[]
  members  ProjectMember[]

  @@map("projects")
}

// ---------------------------------------------------------------------------
// ScanJob — A single scan execution with pipeline status tracking
// ---------------------------------------------------------------------------
// triggerType values: "manual" (default), "github-pr" (automated PR scan via GitHub App)
model ScanJob {
  id                   String    @id @default(uuid())
  projectId            String?   @map("project_id")
  triggerType          String    @default("manual") @map("trigger_type")
  sourceType           String    @map("source_type")
  sourceRef            String?   @map("source_ref")
  status               String    @default("queued")
  overallScore         Int?      @map("overall_score")
  securityScore        Int?      @map("security_score")
  maintainabilityScore Int?      @map("maintainability_score")
  architectureScore    Int?      @map("architecture_score")
  testabilityScore     Int?      @map("testability_score")
  frontendScore        Int?      @map("frontend_score")
  backendScore         Int?      @map("backend_score")
  reliabilityScore     Int?      @map("reliability_score")
  documentationScore   Int?      @map("documentation_score")
  statusResult         String?   @map("status_result")
  failureReason        String?   @map("failure_reason")
  analyzerCoverage     Json?     @map("analyzer_coverage")
  aiSummary            String?   @map("ai_summary")
  refactorPlan         Json?     @map("refactor_plan")
  recommendedTests     Json?     @map("recommended_tests")
  startedBy            String?   @map("started_by")
  startedAt            DateTime? @map("started_at")
  completedAt          DateTime? @map("completed_at")
  scanMode             String    @default("full") @map("scan_mode")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  project       Project?     @relation(fields: [projectId], references: [id])
  startedByUser User?        @relation(fields: [startedBy], references: [id])
  scanFiles     ScanFile[]
  findings      Finding[]
  larkEvents    LarkEvent[]
  metrics       ScanMetrics?

  @@index([projectId])
  @@index([status])
  @@index([createdAt])
  @@map("scan_jobs")
}

// ---------------------------------------------------------------------------
// ScanMetrics — Per-scan performance & observability telemetry (1:1 ScanJob)
// ---------------------------------------------------------------------------
// Persists the timing/coverage/token breakdown that was previously only logged
// to stdout, so scan performance is queryable, chartable, and cost-attributable.
model ScanMetrics {
  id                   String   @id @default(uuid())
  scanJobId            String   @unique @map("scan_job_id")
  queueWaitMs          Int?     @map("queue_wait_ms")
  fetchMs              Int?     @map("fetch_ms")
  classifyMs           Int?     @map("classify_ms")
  staticAnalysisMs     Int?     @map("static_analysis_ms")
  aiReviewMs           Int?     @map("ai_review_ms")
  scoringMs            Int?     @map("scoring_ms")
  totalMs              Int?     @map("total_ms")
  totalFiles           Int?     @map("total_files")
  classifiedFiles      Int?     @map("classified_files")
  analyzedFiles        Int?     @map("analyzed_files")
  staticFindingCount   Int?     @map("static_finding_count")
  aiFindingCount       Int?     @map("ai_finding_count")
  blockingFindingCount Int?     @map("blocking_finding_count")
  aiInputTokens        Int?     @map("ai_input_tokens")
  aiOutputTokens       Int?     @map("ai_output_tokens")
  analyzerBreakdown    Json?    @map("analyzer_breakdown")
  createdAt            DateTime @default(now()) @map("created_at")

  scanJob ScanJob @relation(fields: [scanJobId], references: [id], onDelete: Cascade)

  @@map("scan_metrics")
}

// ---------------------------------------------------------------------------
// ScanFile — Individual files processed during a scan
// ---------------------------------------------------------------------------
model ScanFile {
  id           String   @id @default(uuid())
  scanJobId    String   @map("scan_job_id")
  filePath     String   @map("file_path")
  language     String?
  fileType     String?  @map("file_type")
  linesAdded   Int?     @map("lines_added")
  linesRemoved Int?     @map("lines_removed")
  isFrontend   Boolean  @default(false) @map("is_frontend")
  isBackend    Boolean  @default(false) @map("is_backend")
  createdAt    DateTime @default(now()) @map("created_at")

  scanJob ScanJob @relation(fields: [scanJobId], references: [id], onDelete: Cascade)

  @@index([scanJobId])
  @@map("scan_files")
}

// ---------------------------------------------------------------------------
// Finding — A single issue/violation discovered during scanning
// ---------------------------------------------------------------------------
model Finding {
  id                String   @id @default(uuid())
  scanJobId         String   @map("scan_job_id")
  filePath          String?  @map("file_path")
  lineNumber        Int?     @map("line_number")
  severity           String
  category           String
  title              String
  description        String?
  standardReferences String[] @default([]) @map("standard_references")
  recommendation     String?
  suggestedTests     Json?    @map("suggested_tests")
  blocking           Boolean  @default(false)
  confidence         Float?   @default(0.5)
  source             String
  codeSnippet        String?  @map("code_snippet")
  falsePositive      Boolean  @default(false) @map("false_positive")
  createdAt          DateTime @default(now()) @map("created_at")

  scanJob  ScanJob   @relation(fields: [scanJobId], references: [id], onDelete: Cascade)
  fixTasks FixTask[]

  @@index([scanJobId])
  @@index([scanJobId, severity])
  @@index([scanJobId, falsePositive])
  @@map("findings")
}

// ---------------------------------------------------------------------------
// Rule — Configurable static analysis rules loaded from YAML
// ---------------------------------------------------------------------------
model Rule {
  id        String   @id @default(uuid())
  ruleId    String   @unique @map("rule_id")
  title     String
  category  String
  severity  String
  appliesTo Json     @map("applies_to")
  standards Json
  blocking  Boolean  @default(false)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("rules")
}

// ---------------------------------------------------------------------------
// AuditLog — Security audit trail for security-relevant actions (Req 10.6, B5)
// ---------------------------------------------------------------------------
model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?  @map("actor_id") // null for anonymous/system actions
  action    String // e.g. "login" | "scan.create" | "report.view" | "lark.send" | "finding.false-positive" | "user.role-change"
  target    String? // affected resource id
  ipAddress String?  @map("ip_address")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([action])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// LarkEvent — Audit log for Lark message card sends and webhook events
// ---------------------------------------------------------------------------
model LarkEvent {
  id        String   @id @default(uuid())
  scanJobId String?  @map("scan_job_id")
  eventType String   @map("event_type")
  messageId String?  @map("message_id")
  chatId    String?  @map("chat_id")
  status    String
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")

  scanJob ScanJob? @relation(fields: [scanJobId], references: [id], onDelete: SetNull)

  @@index([scanJobId])
  @@map("lark_events")
}

// ---------------------------------------------------------------------------
// FixTask — Remediation task assigned to a developer for a specific finding
// ---------------------------------------------------------------------------
model FixTask {
  id          String   @id @default(uuid())
  findingId   String   @map("finding_id")
  assignedTo  String?  @map("assigned_to")
  status      String   @default("open")
  title       String
  description String?
  larkTaskId  String?  @map("lark_task_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  finding  Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  assignee User?   @relation(fields: [assignedTo], references: [id])

  @@index([findingId])
  @@index([assignedTo])
  @@map("fix_tasks")
}

// ---------------------------------------------------------------------------
// ProjectMember — Represents membership relation between Project and User
// ---------------------------------------------------------------------------
model ProjectMember {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  role      String   @default("member")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

// ---------------------------------------------------------------------------
// NotificationSetting — Notification alerts preferences for users
// ---------------------------------------------------------------------------
model NotificationSetting {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  emailAlerts Boolean  @default(true) @map("email_alerts")
  slackAlerts Boolean  @default(false) @map("slack_alerts")
  larkAlerts  Boolean  @default(true) @map("lark_alerts")
  minSeverity String   @default("high") @map("min_severity")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

// ---------------------------------------------------------------------------
// GitHubInstallation — Tracks GitHub App installations on orgs/users
// ---------------------------------------------------------------------------
model GitHubInstallation {
  id             String   @id @default(uuid())
  installationId Int      @unique @map("installation_id")
  accountLogin   String   @map("account_login")
  accountType    String   @map("account_type") // "Organization" | "User"
  active         Boolean  @default(true)
  repositories   String[] // Array of "owner/repo" full names
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  repositoryConfigs RepositoryConfig[]

  @@map("github_installations")
}

// ---------------------------------------------------------------------------
// RepositoryConfig — Per-repository scan configuration
// ---------------------------------------------------------------------------
model RepositoryConfig {
  id               String   @id @default(uuid())
  repoFullName     String   @unique @map("repo_full_name") // "owner/repo"
  installationId   String?  @map("installation_id")
  scanThreshold    Int      @default(70) @map("scan_threshold")
  scanMode         String   @default("full") @map("scan_mode")
  autoBlockEnabled Boolean  @default(true) @map("auto_block_enabled")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  installation GitHubInstallation? @relation(fields: [installationId], references: [id])

  @@map("repository_configs")
}

// ---------------------------------------------------------------------------
// PrScanMetadata — Links a ScanJob to its PR context
// ---------------------------------------------------------------------------
model PrScanMetadata {
  id             String   @id @default(uuid())
  scanJobId      String   @unique @map("scan_job_id")
  installationId Int      @map("installation_id")
  repoFullName   String   @map("repo_full_name")
  prNumber       Int      @map("pr_number")
  headSha        String   @map("head_sha")
  headBranch     String   @map("head_branch")
  commentId      Int?     @map("comment_id") // GitHub comment ID for updates
  statusPosted   String?  @map("status_posted") // last posted status state
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([repoFullName, prNumber])
  @@index([installationId])
  @@map("pr_scan_metadata")
}


// ---------------------------------------------------------------------------
// ConnectedAccount — OAuth provider connections (GitHub, Lark) per user
// ---------------------------------------------------------------------------
model ConnectedAccount {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  provider          String    // "github" | "lark"
  providerAccountId String    @map("provider_account_id")
  accessToken       String    @map("access_token")
  refreshToken      String?   @map("refresh_token")
  tokenExpiresAt    DateTime? @map("token_expires_at")
  displayName       String    @map("display_name")
  status            String    @default("connected")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
  @@map("connected_accounts")
}
