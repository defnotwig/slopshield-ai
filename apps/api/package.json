{
  "name": "@slopshield/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:migrate": "prisma migrate dev",
    "db:seed": "ts-node prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "clean": "rimraf dist && rimraf tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@nestjs/bullmq": "^10.2.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/event-emitter": "^2.1.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/platform-socket.io": "^10.4.0",
    "@nestjs/websockets": "^10.4.0",
    "@prisma/client": "^6.0.0",
    "@slopshield/scanner-plugins": "workspace:*",
    "@slopshield/shared": "workspace:*",
    "adm-zip": "^0.5.0",
    "argon2": "^0.41.0",
    "bullmq": "^5.25.0",
    "class-transformer": "^0.5.0",
    "compression": "^1.7.0",
    "dotenv": "^17.4.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.0",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.0",
    "multer": "^1.4.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "socket.io": "^4.8.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.2.0",
    "@nestjs/testing": "^10.4.0",
    "@types/adm-zip": "^0.5.0",
    "@types/compression": "^1.7.0",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/multer": "^1.4.0",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "prisma": "^6.0.0",
    "rimraf": "^6.0.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.7.0"
  }
